---
import AccentBar from "@components/atoms/display/AccentBar.svelte";
import Card from "@components/atoms/display/Card.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { commentConfig, resolveCommentOptions } from "@/config";
import type { CommentContext } from "@/types/commentConfig";

interface Props {
	context: CommentContext;
	postCommentEnabled?: boolean;
	class?: string;
}

const { context, postCommentEnabled = true, class: className } = Astro.props;
const options = resolveCommentOptions(commentConfig);

if (!options || !postCommentEnabled) {
	return null;
}

/**
 * giscus 的输入框不支持上传附件，需要退回 GitHub Discussions 原生编辑器。
 * 构建期先给出按文章 slug 预填的 Discussions 搜索链接作为兜底；
 * giscus 加载后由其 metadata 广播把 href 换成精确的 Discussion URL。
 */
function discussionsSearchUrl(repo: string, path: string): string {
	const slug =
		path.split("/").filter(Boolean).pop() || path.replace(/^\/+|\/+$/g, "");
	return `https://github.com/${repo}/discussions?discussions_q=${encodeURIComponent(slug)}`;
}

const githubDiscussionHref =
	options.provider === "giscus"
		? discussionsSearchUrl(options.giscus.repo, context.path)
		: "";

const Twikoo =
	options.provider === "twikoo"
		? (await import("@components/organisms/comment/Twikoo.astro")).default
		: null;

const Giscus =
	options.provider === "giscus"
		? (await import("@components/organisms/comment/Giscus.astro")).default
		: null;

const Waline =
	options.provider === "waline"
		? (await import("@components/organisms/comment/Waline.astro")).default
		: null;
---

<section
	id="comments"
	aria-labelledby="comments-title"
	class:list={["comment-section w-full mb-4", className]}
	data-comment-section
>
	<Card color="var(--card-bg)" radius="l" class="p-6 md:p-8 w-full relative">
		<div class="flex items-center gap-3 mb-6 relative">
			<AccentBar size="small" class="!inline-block" />
			<h2 id="comments-title" class="text-xl md:text-2xl font-bold text-[var(--on-surface)] m-0">
				{i18n(I18nKey.comments)}
			</h2>
			{options.provider === "giscus" && (
				<a
					href={githubDiscussionHref}
					target="_blank"
					rel="noopener noreferrer"
					data-giscus-discussion-link
					title={i18n(I18nKey.commentsOpenOnGithub)}
					class="ml-auto inline-flex items-center gap-1.5 no-underline rounded-full bg-[var(--surface-container-high)] px-3 py-1.5 text-xs md:text-sm text-[var(--on-surface-variant)] transition-colors hover:text-[var(--on-surface)]"
				>
					<span>{i18n(I18nKey.commentsOpenOnGithub)}</span>
					<span aria-hidden="true">↗</span>
				</a>
			)}
		</div>

		{options.provider === "twikoo" && Twikoo && (
			<Twikoo
				context={context}
				config={options.twikoo}
				lazy={options.lazy}
			/>
		)}

		{options.provider === "giscus" && Giscus && (
			<Giscus
				context={context}
				config={options.giscus}
				lazy={options.lazy}
			/>
		)}

		{options.provider === "waline" && Waline && (
			<Waline
				context={context}
				config={options.waline}
				lazy={options.lazy}
			/>
		)}
	</Card>
</section>
