---
import BannerWaves from "@components/molecules/BannerWaves.astro";
import Icon from "@components/atoms/display/Icon.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { createBannerMedia } from "@utils/banner-media";
import { siteConfig } from "@/config";
import type { SidebarPage } from "@/types/sidebarConfig";

interface Props {
	page?: SidebarPage;
	title?: string;
	description?: string;
	date?: string;
	media?: Awaited<ReturnType<typeof createBannerMedia>>;
}

const {
	page,
	title = "",
	description = "",
	date = "",
	media: providedMedia,
} = Astro.props;
const normalizedTitle = title.trim();
const normalizedDescription = description.trim();
const initialSupportingText =
	normalizedDescription !== normalizedTitle ? normalizedDescription : "";
const initialDate = date.trim();
const initialCopyMode =
	page === "home" ? "home" : page && normalizedTitle ? "context" : "none";
const initialLabel =
	initialCopyMode === "context"
		? normalizedTitle
		: siteConfig.banner.homeText.title;

const media =
	providedMedia ?? (await createBannerMedia(siteConfig.banner, page));
const desktopImages = media.payload.desktop;
const mobileImages = media.payload.mobile;
const desktopLightResponsive = media.desktopResponsive.light;
const mobileLightResponsive = media.mobileResponsive.light;
const dimOpacity = media.payload.dimOpacity;
const rawSubtitles = siteConfig.banner.homeText.subtitle;
const subtitleArray = Array.isArray(rawSubtitles)
	? rawSubtitles
	: [rawSubtitles];
const defaultInitialSubtitle = subtitleArray[0] ?? "";
const subtitlePlaceholder = subtitleArray.reduce(
	(longest, text) => (text.length > longest.length ? text : longest),
	defaultInitialSubtitle,
);
const typewriter = siteConfig.banner.homeText.typewriter;
const contextTypewriter = {
	...typewriter,
	...siteConfig.banner.contextText?.typewriter,
	enable: siteConfig.banner.contextText?.typewriter?.enable === true,
};
const carouselFadeDuration = Math.min(
	Math.max(siteConfig.banner.carousel?.fadeDuration ?? 1200, 300),
	3000,
);
const carouselAnimation = siteConfig.banner.carousel?.animation ?? "ken-burns";
const initialDesktopSrc = desktopImages.light[0] ?? "";
const initialMobileSrc = mobileImages.light[0] ?? "";
const initialSrc = initialDesktopSrc || initialMobileSrc;
const initialDesktopImage = desktopLightResponsive[0];
const initialMobileImage = mobileLightResponsive[0];
const initialImage = initialDesktopImage ?? initialMobileImage;
const initialMobileBanner =
	page === "home" || siteConfig.banner.mobileOnAllPages === true;
---

<section
	id="banner-wrapper"
	class="banner-stage"
	aria-label={`${i18n(I18nKey.wallpaperModeBanner)} · ${initialLabel}`}
	data-label-prefix={i18n(I18nKey.wallpaperModeBanner)}
	data-copy-mode={initialCopyMode}
	data-context-motion="idle"
	data-desktop-images={JSON.stringify(desktopImages)}
	data-mobile-images={JSON.stringify(mobileImages)}
	data-media={JSON.stringify(media.payload)}
	data-mobile-all-pages={String(siteConfig.banner.mobileOnAllPages === true)}
	data-carousel-enabled={String(siteConfig.banner.carousel.enable)}
	data-carousel-interval={String(Math.max(siteConfig.banner.carousel.interval, 3000))}
	data-carousel-fade-duration={String(carouselFadeDuration)}
	data-carousel-animation={carouselAnimation}
	style={`--banner-fade-duration: ${carouselFadeDuration}ms; --banner-dim-opacity: ${dimOpacity}; --banner-dim-light-scale: ${media.payload.dimLightScale};`}
	data-position={siteConfig.banner.position ?? "center"}
	data-home-title={siteConfig.banner.homeText.title}
	data-home-subtitles={JSON.stringify(subtitleArray)}
	data-subtitle-typewriter-enabled={String(typewriter.enable)}
	data-subtitle-typewriter-include-title={String(typewriter.includeTitle ?? false)}
	data-subtitle-typewriter-loop={String(typewriter.loop)}
	data-subtitle-typewriter-speed={String(Math.max(typewriter.speed, 1))}
	data-subtitle-typewriter-delete-speed={String(Math.max(typewriter.deleteSpeed ?? 50, 1))}
	data-subtitle-typewriter-pause-time={String(Math.max(typewriter.pauseTime ?? 2000, 0))}
	data-context-typewriter-enabled={String(contextTypewriter.enable)}
	data-context-typewriter-include-title={String(contextTypewriter.includeTitle ?? false)}
	data-context-typewriter-loop={String(contextTypewriter.loop)}
	data-context-typewriter-speed={String(Math.max(contextTypewriter.speed, 1))}
	data-context-typewriter-delete-speed={String(Math.max(contextTypewriter.deleteSpeed ?? 50, 1))}
	data-context-typewriter-pause-time={String(Math.max(contextTypewriter.pauseTime ?? 2000, 0))}
>
	<div class="banner-stage__media" aria-hidden="true">
		<picture>
			{initialDesktopImage?.avifSrcset && (
				<source media="(min-width: 1024px)" type="image/avif" srcset={initialDesktopImage.avifSrcset} sizes="100vw" />
			)}
			{initialDesktopImage?.webpSrcset && (
				<source media="(min-width: 1024px)" type="image/webp" srcset={initialDesktopImage.webpSrcset} sizes="100vw" />
			)}
			{initialDesktopImage && !initialDesktopImage.avifSrcset && !initialDesktopImage.webpSrcset && (
				<source media="(min-width: 1024px)" srcset={initialDesktopImage.fallback} />
			)}
			{initialMobileBanner && initialMobileImage?.avifSrcset && (
				<source media="(max-width: 1023.98px)" type="image/avif" srcset={initialMobileImage.avifSrcset} sizes="100vw" />
			)}
			{initialMobileBanner && initialMobileImage?.webpSrcset && (
				<source media="(max-width: 1023.98px)" type="image/webp" srcset={initialMobileImage.webpSrcset} sizes="100vw" />
			)}
			{initialMobileBanner && initialMobileImage && !initialMobileImage.avifSrcset && !initialMobileImage.webpSrcset && (
				<source media="(max-width: 1023.98px)" srcset={initialMobileImage.fallback} />
			)}
			<img
				class="banner-stage__image banner-stage__image--front banner-stage__image--active"
				src={initialMobileBanner ? initialSrc || undefined : undefined}
				width={initialImage?.width}
				height={initialImage?.height}
				fetchpriority="high"
				loading="eager"
				decoding="async"
				alt=""
				style={`object-position: ${siteConfig.banner.position ?? "center"};`}
			/>
		</picture>
		<img class="banner-stage__image banner-stage__image--back" alt="" />
	</div>
	{siteConfig.banner.dim.enable && (
		<div class="banner-stage__scrim"></div>
	)}
	{siteConfig.banner.homeText.enable && (
		<div class="banner-stage__copy banner-stage__copy--home" data-banner-home-copy>
			<h1
				aria-label={siteConfig.banner.homeText.title}
				data-typing-placeholder={siteConfig.banner.homeText.title}
				data-title-state="complete"
			>
				<span data-typewriter-text aria-hidden="true">{siteConfig.banner.homeText.title}</span>
			</h1>
			<p
				data-subtitle-label={defaultInitialSubtitle}
				data-typing-placeholder={subtitlePlaceholder}
				data-subtitle-state="complete"
			>
				<span class="sr-only" data-typewriter-accessible>{defaultInitialSubtitle}</span>
				<span data-typewriter-text aria-hidden="true">{defaultInitialSubtitle}</span>
			</p>
		</div>
	)}
	<div class="banner-stage__copy banner-stage__copy--context" data-banner-context>
		<div class="banner-stage__context-title" role="heading" aria-level="1" data-banner-context-title aria-label={normalizedTitle} data-typing-placeholder={normalizedTitle} data-title-state="complete">
			<span data-typewriter-text aria-hidden="true">{normalizedTitle}</span>
		</div>
		<div
			class="banner-stage__context-details"
			data-banner-context-details
			hidden={!initialSupportingText && !initialDate}
		>
			<span class="banner-stage__context-divider" aria-hidden="true"></span>
			<p data-banner-context-description hidden={!initialSupportingText} data-subtitle-label={initialSupportingText} data-typing-placeholder={initialSupportingText} data-subtitle-state="complete">
				<span class="sr-only" data-typewriter-accessible>{initialSupportingText}</span>
				<span data-typewriter-text aria-hidden="true">{initialSupportingText}</span>
			</p>
			<div class="banner-stage__context-meta" data-banner-context-meta hidden={!initialDate}>
				<Icon icon="material-symbols:calendar-today-rounded" aria-hidden="true" />
				<time data-banner-context-date datetime={initialDate}>{initialDate}</time>
			</div>
		</div>
	</div>
	{siteConfig.banner.waves.enable && <BannerWaves />}
</section>

<script>
	import { resolveBannerState, type BannerViewport } from "@utils/banner-state";
	import {
		playBannerMotion,
		type BannerAnimationHandle,
		type BannerAnimationPreset,
	} from "@utils/banner-animation";
	import {
		EASING_ACCELERATE,
		EASING_DECELERATE,
		prefersReducedMotion,
	} from "@utils/motion";
	import { getStoredWallpaperMode } from "@utils/setting-utils";
	import { WALLPAPER_MODE_CHANGE_EVENT, THEME_CHANGE_EVENT } from "@constants/constants";
	import type { SidebarPage } from "@/types/sidebarConfig";

	interface BannerRuntime {
		activeGroup: BannerViewport | null;
		activeIndex: number;
		activeLayer: 0 | 1;
		images: Record<BannerViewport, { light: string[]; dark: string[] }>;
		activeTheme: "light" | "dark";
		preloaded: HTMLImageElement | null;
		subtitleGeneration: number;
		subtitleKey: string | null;
		mediaKey: string;
		contextKey: string;
		subtitleTimer: number | null;
		subtitleVisible: boolean;
		contextAnimation: Animation | null;
		contextTransitionPending: boolean;
		titleFitFrame: number | null;
		navigationSyncFrame: number | null;
		timer: number | null;
		layerMotions: [BannerAnimationHandle | null, BannerAnimationHandle | null];
		carouselMediaPrepared: boolean;
	}

	declare global {
		interface Window {
			__shironeBannerBound?: boolean;
		}
	}

	const stage = document.getElementById("banner-wrapper") as HTMLElement | null;
	const layers = stage
		? [...stage.querySelectorAll<HTMLImageElement>(".banner-stage__image")]
		: [];
	const subtitle = stage?.querySelector<HTMLParagraphElement>(
		"[data-banner-home-copy] p",
	);
	const homeTitle = stage?.querySelector<HTMLHeadingElement>(
		"[data-banner-home-copy] h1",
	);
	const titleText = homeTitle?.querySelector<HTMLElement>("[data-typewriter-text]");
	const subtitleText = subtitle?.querySelector<HTMLElement>("[data-typewriter-text]");
	const subtitleAccessibleText = subtitle?.querySelector<HTMLElement>("[data-typewriter-accessible]");
	const contextTitle = stage?.querySelector<HTMLElement>(
		"[data-banner-context-title]",
	);
	const contextDescription = stage?.querySelector<HTMLElement>(
		"[data-banner-context-description]",
	);
	const contextTitleText = contextTitle?.querySelector<HTMLElement>("[data-typewriter-text]");
	const contextDescriptionText = contextDescription?.querySelector<HTMLElement>("[data-typewriter-text]");
	const contextDescriptionAccessible = contextDescription?.querySelector<HTMLElement>("[data-typewriter-accessible]");
	const contextDetails = stage?.querySelector<HTMLElement>(
		"[data-banner-context-details]",
	);
	const contextMeta = stage?.querySelector<HTMLElement>(
		"[data-banner-context-meta]",
	);
	const contextDate = stage?.querySelector<HTMLTimeElement>(
		"[data-banner-context-date]",
	);
	function parseThemeImages(value: string | undefined): { light: string[]; dark: string[] } {
		if (!value) return { light: [], dark: [] };
		try {
			const parsed = JSON.parse(value);
			if (Array.isArray(parsed)) {
				const list = parsed.filter((item): item is string => typeof item === "string");
				return { light: list, dark: list };
			}
			if (typeof parsed === "object" && parsed !== null) {
				return {
					light: Array.isArray(parsed.light) ? parsed.light.filter((i: unknown): i is string => typeof i === "string") : [],
					dark: Array.isArray(parsed.dark) ? parsed.dark.filter((i: unknown): i is string => typeof i === "string") : [],
				};
			}
			return { light: [], dark: [] };
		} catch {
			return { light: [], dark: [] };
		}
	}

	function isDarkMode(): boolean {
		return document.documentElement.classList.contains("dark");
	}

	function getActiveImages(viewport: BannerViewport): string[] {
		const store = runtime.images[viewport];
		const mode = isDarkMode() ? "dark" : "light";
		return store[mode] ?? [];
	}

	const runtime: BannerRuntime = {
		activeGroup: null,
		activeIndex: 0,
		activeLayer: 0,
		images: {
			desktop: parseThemeImages(stage?.dataset.desktopImages),
			mobile: parseThemeImages(stage?.dataset.mobileImages),
		},
		activeTheme: isDarkMode() ? "dark" : "light",
		preloaded: null,
		subtitleGeneration: 0,
		subtitleKey: null,
		mediaKey: stage?.dataset.media || "",
		contextKey: "",
		subtitleTimer: null,
		subtitleVisible: false,
		contextAnimation: null,
		contextTransitionPending: false,
		titleFitFrame: null,
		navigationSyncFrame: null,
		timer: null,
		layerMotions: [null, null],
		carouselMediaPrepared: false,
	};

	function currentPage(): SidebarPage | undefined {
		return document.getElementById("swup-container")?.dataset.currentPage as
			| SidebarPage
			| undefined;
	}

	function currentViewport(): BannerViewport {
		return window.matchMedia("(min-width: 1024px)").matches
			? "desktop"
			: "mobile";
	}

	function stopRotation() {
		if (runtime.timer !== null) window.clearTimeout(runtime.timer);
		runtime.timer = null;
	}

	function subtitleSegments(value: string): string[] {
		if (typeof Intl.Segmenter === "function") {
			const segmenter = new Intl.Segmenter(undefined, {
				granularity: "grapheme",
			});
			return [...segmenter.segment(value)].map(({ segment }) => segment);
		}
		return Array.from(value);
	}

	function getSubtitleTexts(): string[] {
		try {
			const parsed = JSON.parse(stage?.dataset.homeSubtitles || "[]");
			if (Array.isArray(parsed) && parsed.length > 0) {
				return parsed.filter(Boolean);
			}
		} catch {
			// ignore
		}
		const initial =
			subtitle?.dataset.subtitleLabel || subtitleText?.textContent || "";
		return initial ? [initial] : [];
	}

	function stopSubtitleTyping() {
		runtime.subtitleGeneration += 1;
		if (runtime.subtitleTimer !== null) {
			window.clearTimeout(runtime.subtitleTimer);
		}
		runtime.subtitleTimer = null;
		runtime.subtitleVisible = false;
		if (homeTitle && titleText) {
			titleText.textContent = stage?.dataset.homeTitle || "";
			homeTitle.dataset.titleState = "complete";
		}
		if (subtitle && subtitleText) {
			const texts = getSubtitleTexts();
			subtitleText.textContent = texts[0] || "";
			subtitle.dataset.subtitleLabel = texts[0] || "";
			if (subtitleAccessibleText) subtitleAccessibleText.textContent = texts[0] || "";
			subtitle.dataset.subtitleState = "complete";
		}
		if (contextTitle && contextTitleText) {
			contextTitleText.textContent = contextTitle.dataset.typingPlaceholder || "";
			contextTitle.dataset.titleState = "complete";
		}
		if (contextDescription && contextDescriptionText) {
			contextDescriptionText.textContent = contextDescription.dataset.typingPlaceholder || "";
			contextDescription.dataset.subtitleState = "complete";
		}
	}

	function showSubtitleImmediately() {
		stopSubtitleTyping();
		runtime.subtitleVisible = true;
	}

	function readMotionDuration(property: string, fallback: number): number {
		const value = Number.parseFloat(
			getComputedStyle(document.documentElement).getPropertyValue(property),
		);
		return Number.isFinite(value) && value > 0 ? value : fallback;
	}

	function startSubtitleTyping(page: SidebarPage | undefined) {
		const isHome = page === "home";
		const typingTitle = isHome ? homeTitle : contextTitle;
		const typingTitleText = isHome ? titleText : contextTitleText;
		const typingSubtitle = isHome ? subtitle : contextDescription;
		const typingSubtitleText = isHome ? subtitleText : contextDescriptionText;
		const typingAccessibleText = isHome ? subtitleAccessibleText : contextDescriptionAccessible;
		if (!typingSubtitle || !typingSubtitleText || !page) {
			stopSubtitleTyping();
			runtime.subtitleKey = null;
			return;
		}
		const prefix = isHome ? "subtitleTypewriter" : "contextTypewriter";
		const setting = (suffix: string) => stage?.dataset[`${prefix}${suffix}`];
		const fullTitle = isHome ? stage?.dataset.homeTitle || "" : typingTitle?.dataset.typingPlaceholder || "";
		const texts = isHome ? getSubtitleTexts() : [typingSubtitle.dataset.typingPlaceholder || ""];
		if (!texts.length) texts.push("");
		const key = JSON.stringify([page, fullTitle, texts, prefersReducedMotion(), setting("Enabled")]);
		if (runtime.subtitleKey === key && runtime.subtitleVisible) return;
		stopSubtitleTyping();
		runtime.subtitleKey = key;
		if (setting("Enabled") !== "true" || prefersReducedMotion()) {
			showSubtitleImmediately();
			return;
		}

		runtime.subtitleGeneration += 1;
		const generation = runtime.subtitleGeneration;
		if (runtime.subtitleTimer !== null) {
			window.clearTimeout(runtime.subtitleTimer);
		}
		runtime.subtitleTimer = null;
		runtime.subtitleVisible = true;

		const includeTitle = setting("IncludeTitle") === "true" &&
			Boolean(typingTitle && typingTitleText);
		const titleSegments = includeTitle
			? subtitleSegments(fullTitle)
			: [];
		const subtitleParts = texts.map(subtitleSegments);

		const loop = setting("Loop") === "true";
		const configuredSpeed = Number.parseFloat(
			setting("Speed") || "120",
		);
		const speed = Number.isFinite(configuredSpeed)
			? Math.max(configuredSpeed, 1)
			: 120;
		const configuredDeleteSpeed = Number.parseFloat(
			setting("DeleteSpeed") || "50",
		);
		const deleteSpeed = Number.isFinite(configuredDeleteSpeed)
			? Math.max(configuredDeleteSpeed, 1)
			: 50;
		const configuredPauseTime = Number.parseFloat(
			setting("PauseTime") || "2000",
		);
		const pauseTime = Number.isFinite(configuredPauseTime)
			? Math.max(configuredPauseTime, 0)
			: 2000;

		let textIndex = 0;
		let charIndex = 0;
		let phase: "title" | "subtitle" | "delete-subtitle" | "delete-title" =
			includeTitle ? "title" : "subtitle";
		typingSubtitleText.textContent = "";
		typingSubtitle.dataset.subtitleState = "complete";
		if (includeTitle && typingTitle && typingTitleText) {
			typingTitleText.textContent = "";
			typingTitle.dataset.titleState = "typing";
		}

		const schedule = (delay: number) => {
			runtime.subtitleTimer = window.setTimeout(step, delay);
		};
		const nextText = () => {
			textIndex = (textIndex + 1) % texts.length;
			charIndex = 0;
			phase = includeTitle ? "title" : "subtitle";
			schedule(speed);
		};

		const step = () => {
			if (generation !== runtime.subtitleGeneration) return;
			runtime.subtitleTimer = null;
			// A preference can change while the shared timer is waiting to run.
			if (prefersReducedMotion()) {
				showSubtitleImmediately();
				return;
			}

			const onTitle = phase === "title" || phase === "delete-title";
			const deleting = phase === "delete-subtitle" || phase === "delete-title";
			const element = onTitle ? typingTitle : typingSubtitle;
			const text = onTitle ? typingTitleText : typingSubtitleText;
			const segments = onTitle ? titleSegments : subtitleParts[textIndex];
			if (!element || !text) return;
			const stateKey = onTitle ? "titleState" : "subtitleState";
			element.dataset[stateKey] = "typing";
			if (!onTitle && typingSubtitle.dataset.subtitleLabel !== texts[textIndex]) {
				typingSubtitle.dataset.subtitleLabel = texts[textIndex];
				if (typingAccessibleText) typingAccessibleText.textContent = texts[textIndex];
			}
			charIndex = deleting
				? Math.max(charIndex - 1, 0)
				: Math.min(charIndex + 1, segments.length);
			text.textContent = segments.slice(0, charIndex).join("");

			if (deleting && charIndex === 0) {
				element.dataset[stateKey] = "complete";
				if (phase === "delete-subtitle" && includeTitle) {
					phase = "delete-title";
					charIndex = titleSegments.length;
					schedule(deleteSpeed);
				} else nextText();
			} else if (!deleting && charIndex === segments.length) {
				element.dataset[stateKey] = "complete";
				if (phase === "title") {
					phase = "subtitle";
					charIndex = 0;
					schedule(speed);
				} else if (texts.length > 1 || loop) {
					phase = "delete-subtitle";
					schedule(pauseTime);
				}
			} else schedule(deleting ? deleteSpeed : speed);
		};

		step();
	}

	function preloadNext(images: string[], index: number) {
		if (images.length < 2) return;
		const mediaKey = runtime.mediaKey;
		const schedulePreload = () => {
			const load = () => {
				if (runtime.mediaKey !== mediaKey || stage?.hidden) return;
				runtime.preloaded = new Image();
				runtime.preloaded.src = images[(index + 1) % images.length];
			};
			if (typeof window.requestIdleCallback === "function") {
				window.requestIdleCallback(load, { timeout: 3000 });
			} else {
				window.setTimeout(load, 1500);
			}
		};
		const current = layers[runtime.activeLayer];
		if (current && !current.complete) {
			current.addEventListener("load", schedulePreload, { once: true });
		} else {
			schedulePreload();
		}
	}

	function getCarouselInterval(): number {
		return Math.max(
			Number.parseInt(stage?.dataset.carouselInterval || "6000", 10),
			3000,
		);
	}

	function getFadeDuration(): number {
		return Math.max(
			Number.parseInt(stage?.dataset.carouselFadeDuration || "1200", 10),
			300,
		);
	}

	function getAnimationPreset(): BannerAnimationPreset {
		return (
			(stage?.dataset.carouselAnimation as BannerAnimationPreset) ||
			"ken-burns"
		);
	}

	function stopLayerMotions() {
		runtime.layerMotions[0]?.cancel();
		runtime.layerMotions[0] = null;
		runtime.layerMotions[1]?.cancel();
		runtime.layerMotions[1] = null;
	}

	function pauseLayerMotions() {
		runtime.layerMotions[0]?.pause();
		runtime.layerMotions[1]?.pause();
	}

	function resumeLayerMotions() {
		runtime.layerMotions[0]?.resume();
		runtime.layerMotions[1]?.resume();
	}

	// Remove the `<picture><source>` elements after the runtime takes over; otherwise,
	// modifying `src` on the `<img>` tag is overridden by the initial `<source>` element.
	function detachInitialPictureSources() {
		stage
			?.querySelectorAll(".banner-stage__media picture source")
			.forEach((source) => source.remove());
	}

	function prepareCarouselMedia(images: string[]) {
		if (runtime.carouselMediaPrepared || !stage || images.length < 2) return;
		if (stage.dataset.carouselEnabled !== "true") return;
		detachInitialPictureSources();
		runtime.carouselMediaPrepared = true;
	}

	function resolveImageUrl(src: string): string {
		return new URL(src, window.location.href).href;
	}

	function prepareLayerImage(
		layer: HTMLImageElement,
		src: string,
	): Promise<void> {
		const resolved = resolveImageUrl(src);
		layer.removeAttribute("srcset");
		layer.removeAttribute("sizes");
		layer.style.objectPosition = stage?.dataset.position || "center";
		if (layer.src === resolved && layer.complete) return Promise.resolve();
		return new Promise((resolve) => {
			const finish = () => resolve();
			layer.addEventListener("load", finish, { once: true });
			layer.addEventListener("error", finish, { once: true });
			if (layer.src !== resolved) layer.src = src;
			if (layer.complete) finish();
		});
	}

	function startLayerMotion(layerIndex: 0 | 1, element: HTMLImageElement) {
		if (prefersReducedMotion()) return;
		const interval = getCarouselInterval();
		const fadeDuration = getFadeDuration();
		runtime.layerMotions[layerIndex]?.cancel();
		runtime.layerMotions[layerIndex] = playBannerMotion({
			element,
			preset: getAnimationPreset(),
			index: runtime.activeIndex,
			durationMs: interval + fadeDuration,
		});
	}

	function crossfadeToLayer(nextLayer: 0 | 1) {
		const next = layers[nextLayer];
		const previous = layers[runtime.activeLayer];
		const previousLayer = runtime.activeLayer;

		runtime.layerMotions[previousLayer]?.cancel();
		runtime.layerMotions[previousLayer] = null;

		next.classList.add("banner-stage__image--fading");
		previous.classList.add("banner-stage__image--fading");
		// Force a reflow to ensure the opacity transition interpolates correctly from the current frame
		void next.offsetWidth;
		next.classList.add("banner-stage__image--active");
		previous.classList.remove("banner-stage__image--active");

		runtime.activeLayer = nextLayer;
		startLayerMotion(nextLayer, next);
	}

	function applyImmediateLayer(nextLayer: 0 | 1) {
		const next = layers[nextLayer];
		for (let i = 0; i < layers.length; i += 1) {
			if (i !== nextLayer) {
				layers[i].classList.remove("banner-stage__image--active");
				layers[i].classList.remove("banner-stage__image--fading");
				runtime.layerMotions[i]?.cancel();
				runtime.layerMotions[i] = null;
			}
		}
		next.classList.add("banner-stage__image--active");
		next.classList.remove("banner-stage__image--fading");
		runtime.activeLayer = nextLayer;
	}

	function showImageImmediate(nextLayer: 0 | 1, src: string) {
		const next = layers[nextLayer];
		const resolved = resolveImageUrl(src);
		next.removeAttribute("srcset");
		next.removeAttribute("sizes");
		next.style.objectPosition = stage?.dataset.position || "center";
		if (next.src !== resolved) next.src = src;
		if (next.complete) {
			applyImmediateLayer(nextLayer);
			return;
		}
		void prepareLayerImage(next, src).then(() => {
			if (next.src !== resolved) return;
			applyImmediateLayer(nextLayer);
		});
	}

	function showImage(src: string, immediate: boolean) {
		if (!layers.length) return;
		const nextLayer: 0 | 1 = immediate
			? runtime.activeLayer
			: runtime.activeLayer === 0
				? 1
				: 0;
		const next = layers[nextLayer];

		if (immediate || prefersReducedMotion()) {
			showImageImmediate(nextLayer, src);
			return;
		}

		void prepareLayerImage(next, src).then(() => {
			if (next.src !== resolveImageUrl(src)) return;
			crossfadeToLayer(nextLayer);
		});
	}

	function scheduleRotation(images: string[]) {
		stopRotation();
		const delay = Number.parseInt(stage?.dataset.carouselInterval || "6000", 10);
		runtime.timer = window.setTimeout(() => {
			runtime.activeIndex = (runtime.activeIndex + 1) % images.length;
			showImage(images[runtime.activeIndex], false);
			preloadNext(images, runtime.activeIndex);
			syncBanner();
		}, delay);
	}

	function canAnimateBannerContext(): boolean {
		return (
			currentViewport() === "desktop" &&
			stage?.hidden === false &&
			!prefersReducedMotion()
		);
	}

	function settleContextAnimation() {
		runtime.contextAnimation?.cancel();
		runtime.contextAnimation = null;
		if (!stage) return;
		stage.dataset.contextMotion = "idle";
	}

	function animateContextOut() {
		runtime.contextTransitionPending = canAnimateBannerContext();
		settleContextAnimation();
		if (
			!runtime.contextTransitionPending ||
			stage?.dataset.copyMode !== "context" ||
			!contextTitle
		)
			return;
		const copy = contextTitle.closest<HTMLElement>("[data-banner-context]");
		if (!copy) return;
		stage!.dataset.contextMotion = "out";
		runtime.contextAnimation = copy.animate(
			[
				{ opacity: 1, transform: "translate(-50%, -50%) translateY(0)" },
				{ opacity: 0, transform: "translate(-50%, -50%) translateY(-0.25rem)" },
			],
			{
				duration: readMotionDuration("--m3e-duration-short", 150),
				easing: EASING_ACCELERATE,
				fill: "forwards",
			},
		);
	}

	function animateContextIn() {
		const shouldAnimate =
			runtime.contextTransitionPending &&
			canAnimateBannerContext() &&
			stage?.dataset.copyMode === "context";
		runtime.contextTransitionPending = false;
		settleContextAnimation();
		if (!shouldAnimate || !contextTitle) return;
		const copy = contextTitle.closest<HTMLElement>("[data-banner-context]");
		if (!copy) return;
		stage!.dataset.contextMotion = "in";
		runtime.contextAnimation = copy.animate(
			[
				{ opacity: 0, transform: "translate(-50%, -50%) translateY(0.25rem)" },
				{ opacity: 1, transform: "translate(-50%, -50%) translateY(0)" },
			],
			{
				duration: readMotionDuration("--m3e-duration-medium", 250),
				easing: EASING_DECELERATE,
			},
		);
		runtime.contextAnimation.onfinish = settleContextAnimation;
		runtime.contextAnimation.oncancel = () => {
			runtime.contextAnimation = null;
		};
	}

	function fitContextTitle() {
		if (!contextTitle || !stage || stage.dataset.copyMode !== "context") return;
		contextTitle.style.removeProperty("font-size");
		contextTitle.dataset.titleFit = "full";
		if (contextTitle.scrollWidth <= contextTitle.clientWidth) return;

		const rootFontSize = Number.parseFloat(
			getComputedStyle(document.documentElement).fontSize,
		);
		const maximum = Number.parseFloat(getComputedStyle(contextTitle).fontSize);
		const minimum = Number.isFinite(rootFontSize) ? rootFontSize * 2.25 : 36;
		let lower = Math.min(minimum, maximum);
		let upper = maximum;

		contextTitle.dataset.titleFit = "scaled";
		for (let step = 0; step < 8; step += 1) {
			const candidate = (lower + upper) / 2;
			contextTitle.style.fontSize = `${candidate}px`;
			if (contextTitle.scrollWidth <= contextTitle.clientWidth) lower = candidate;
			else upper = candidate;
		}
		contextTitle.style.fontSize = `${lower}px`;
		if (contextTitle.scrollWidth > contextTitle.clientWidth) {
			contextTitle.style.removeProperty("font-size");
			contextTitle.dataset.titleFit = "wrapped";
		}
	}

	function scheduleContextTitleFit() {
		if (runtime.titleFitFrame !== null) {
			window.cancelAnimationFrame(runtime.titleFitFrame);
		}
		runtime.titleFitFrame = window.requestAnimationFrame(() => {
			runtime.titleFitFrame = null;
			fitContextTitle();
		});
	}

	interface BannerContext {
		title: string;
		description: string;
		date: string;
	}

	function readContext(): BannerContext {
		const container = document.getElementById("swup-container");
		return {
			title: container?.dataset.bannerTitle?.trim() || "",
			description: container?.dataset.bannerDescription?.trim() || "",
			date: container?.dataset.bannerDate?.trim() || "",
		};
	}

	function syncContext(context: BannerContext) {
		if (
			!stage ||
			!contextTitle ||
			!contextDescription ||
			!contextDetails ||
			!contextMeta ||
			!contextDate
		)
			return false;
		const title = context.title;
		const description = context.description !== title ? context.description : "";
		const date = context.date;
		const key = JSON.stringify([title, description, date]);
		if (runtime.contextKey === key) return Boolean(title);
		runtime.contextKey = key;
		contextTitle.style.removeProperty("font-size");
		contextTitle.dataset.titleFit = "full";
		contextTitle.dataset.typingPlaceholder = title;
		contextTitle.setAttribute("aria-label", title);
		if (contextTitleText) contextTitleText.textContent = title;
		contextDescription.dataset.typingPlaceholder = description;
		contextDescription.dataset.subtitleLabel = description;
		if (contextDescriptionText) contextDescriptionText.textContent = description;
		if (contextDescriptionAccessible) contextDescriptionAccessible.textContent = description;
		contextDescription.hidden = !description;
		contextDate.textContent = date;
		contextDate.dateTime = date;
		contextMeta.hidden = !date;
		contextDetails.hidden = !description && !date;
		scheduleContextTitleFit();
		return Boolean(title);
	}

	function syncRouteMedia(): boolean {
		const serialized = document.getElementById("swup-container")?.dataset.bannerMedia;
		if (!stage || !serialized || serialized === runtime.mediaKey) return false;
		try {
			const media = JSON.parse(serialized);
			const desktop = JSON.stringify(media.desktop);
			const mobile = JSON.stringify(media.mobile);
			runtime.images = {
				desktop: parseThemeImages(desktop),
				mobile: parseThemeImages(mobile),
			};
			runtime.mediaKey = serialized;
			stage.dataset.media = serialized;
			stage.dataset.desktopImages = desktop;
			stage.dataset.mobileImages = mobile;
			if (typeof media.dimOpacity === "number") {
				stage.style.setProperty("--banner-dim-opacity", String(Math.min(Math.max(media.dimOpacity, 0), 1)));
			}
			if (typeof media.dimLightScale === "number") {
				stage.style.setProperty("--banner-dim-light-scale", String(Math.min(Math.max(media.dimLightScale, 0), 1)));
			}
			stopRotation();
			stopLayerMotions();
			runtime.preloaded = null;
			return true;
		} catch {
			return false;
		}
	}

	function syncBanner(pageOverride?: SidebarPage, contextOverride?: BannerContext) {
		if (!stage) return;
		const mediaChanged = syncRouteMedia();
		const viewport = currentViewport();
		const images = getActiveImages(viewport);
		const currentTheme = isDarkMode() ? "dark" : "light";
		const themeChanged = runtime.activeTheme !== currentTheme;
		runtime.activeTheme = currentTheme;

		// The SSR `<picture>` sources are built for the initial (light) image. They
		// would keep overriding `showImage()`'s themed `img.src`, so detach them on
		// the first dark sync or any theme switch. Desktop and mobile share this path.
		if (
			mediaChanged || themeChanged ||
			(runtime.activeGroup === null && currentTheme === "dark")
		) {
			detachInitialPictureSources();
		}

		const page = pageOverride ?? currentPage();
		const state = resolveBannerState({
			mode: getStoredWallpaperMode(),
			page,
			viewport,
			imageCount: images.length,
			carouselEnabled: stage.dataset.carouselEnabled === "true",
			reducedMotion: prefersReducedMotion(),
			mobileOnAllPages: stage.dataset.mobileAllPages === "true",
		});

		document.body.dataset.currentPage = page || "";
		document.body.dataset.bannerVisible = String(state.visible);
		document.body.dataset.bannerLayout = state.contentLayout;
		document.body.dataset.bannerTopAppBar = String(state.transparentTopAppBar);
		document.body.dataset.bannerHasDesktop = String(runtime.images.desktop.light.length + runtime.images.desktop.dark.length > 0);
		document.body.dataset.bannerHasMobile = String(runtime.images.mobile.light.length + runtime.images.mobile.dark.length > 0);
		stage.hidden = !state.visible;
		const hasContext =
			state.copyMode === "context" && syncContext(contextOverride ?? readContext());
		const copyMode = state.copyMode === "home" ? "home" : hasContext ? "context" : "none";
		stage.dataset.copyMode = copyMode;
		stage.setAttribute(
			"aria-label",
			`${stage.dataset.labelPrefix} · ${copyMode === "context"
				? contextTitle?.dataset.typingPlaceholder || ""
				: stage.dataset.homeTitle || ""}`,
		);
		if (copyMode === "home" || copyMode === "context") startSubtitleTyping(page);
		else stopSubtitleTyping();

		if (!state.visible || !state.assetGroup) {
			stopRotation();
			stopLayerMotions();
			return;
		}

		prepareCarouselMedia(images);

		if (runtime.activeGroup !== state.assetGroup || themeChanged || mediaChanged) {
			runtime.activeGroup = state.assetGroup;
			runtime.activeIndex = 0;
			showImage(images[0], true);
			layers[runtime.activeLayer]?.setAttribute("fetchpriority", "high");
			preloadNext(images, 0);
		}

		if (state.rotate && !document.hidden) scheduleRotation(images);
		else stopRotation();
	}

	function scheduleNavigationSync(animateIn = false) {
		if (runtime.navigationSyncFrame !== null) {
			window.cancelAnimationFrame(runtime.navigationSyncFrame);
		}
		runtime.navigationSyncFrame = window.requestAnimationFrame(() => {
			runtime.navigationSyncFrame = null;
			syncBanner();
			if (animateIn) animateContextIn();
		});
	}

	if (stage) {
		syncBanner();
		if (!window.__shironeBannerBound) {
			window.__shironeBannerBound = true;
			window.addEventListener(WALLPAPER_MODE_CHANGE_EVENT, () => syncBanner());
			window.addEventListener(THEME_CHANGE_EVENT, () => syncBanner());
			let lastReducedMotion = prefersReducedMotion();
			new MutationObserver(() => {
				const reduced = prefersReducedMotion();
				if (reduced === lastReducedMotion) return;
				lastReducedMotion = reduced;
				if (reduced) stopLayerMotions();
				syncBanner();
			}).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
			window.addEventListener("resize", () => {
				if (stage?.hidden === false) {
					scheduleContextTitleFit();
				}
			});
			window.matchMedia("(min-width: 1024px)").addEventListener("change", () => syncBanner());
				window.matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", () => {
					if (prefersReducedMotion()) {
						stopLayerMotions();
						showSubtitleImmediately();
					}
					syncBanner();
				});
			document.addEventListener("visibilitychange", () => {
					if (document.hidden) {
						pauseLayerMotions();
					} else {
						resumeLayerMotions();
					}
					syncBanner();
				});
			document.addEventListener("swup:visit:start", () => {
				stopSubtitleTyping();
				animateContextOut();
			});
			document.addEventListener("swup:content:replace", () => {
				scheduleNavigationSync(true);
			});
			document.addEventListener("swup:page:view", () => {
				scheduleNavigationSync(true);
			});
			document.fonts?.ready.then(scheduleContextTitleFit);
		}
	}
</script>

