	min-width: 0
.garden-featured__label
	display: flex
	align-items: center
	gap: var(--m3e-space-2)
	font: var(--m3e-type-label-small)
	color: var(--primary)
	letter-spacing: .06em
	span
		color: var(--outline-variant)
.garden-featured h2
	font: var(--m3e-type-title-large)
	font-weight: 600
	margin-top: var(--m3e-space-2)
.garden-featured h2 a:hover, .garden-post h3 a:hover
