		min-height: 40px
@media (prefers-reduced-motion: reduce)
	.garden-post, .garden-post__image-link img
		transition: none
	.garden-post:hover, .garden-post:hover .garden-post__image-link img
		transform: none
:global(html.motion-reduced) .garden-post, :global(html.motion-reduced) .garden-post__image-link img
	transition: none
</style>
