		.garden-post
			grid-template-columns: 28% minmax(0, 1fr)
		.garden-post__image-link
			min-height: 200px
		.garden-post__category, .garden-post__number
			display: none
	.garden-filter
		gap: var(--m3e-space-1)
	.garden-filter__item
		padding: var(--m3e-space-3)
	.garden-view__button, .garden-post__read
