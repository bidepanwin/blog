---
import type { CollectionEntry } from "astro:content";
import Icon from "@components/atoms/display/Icon.svelte";
import Key from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getPostUrl, url } from "@utils/url-utils";

interface Props {
	posts: CollectionEntry<"posts">[];
	showFeatured?: boolean;
}
const { posts, showFeatured = true } = Astro.props;
const featured = showFeatured
	? posts.find((post) => post.data.pinned)
	: undefined;
const displayPosts = posts.filter((post) => post !== featured);
const categories = [
	...new Set(displayPosts.map((post) => post.data.category).filter(Boolean)),
];
const minutes = (post: CollectionEntry<"posts">) =>
	i18n(Key.gardenReadingTime).replace(
		"{minutes}",
		String(Math.max(2, Math.ceil((post.body?.length ?? 0) / 350))),
	);
const date = (published: Date) =>
	new Intl.DateTimeFormat("zh-CN", {
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
		timeZone: "Asia/Shanghai",
	})
		.format(published)
		.replaceAll("/", ".");
---

<section class="garden-hero" aria-labelledby="garden-welcome">
	<img src={url("/images/garden/hero.webp")} width="1500" height="1000" alt="" fetchpriority="high" loading="eager" class="garden-hero__image" />
	<div class="garden-hero__veil"></div>
	<div class="garden-hero__content">
		<p class="garden-hero__eyebrow"><span></span>{i18n(Key.gardenHeroEyebrow)}</p>
		<h1 id="garden-welcome">{i18n(Key.gardenHeroTitle)}<br /><em>{i18n(Key.gardenHeroAccent)}</em></h1>
		<p class="garden-hero__description">{i18n(Key.gardenHeroDescription)}</p>
		<a href="#garden-journal" class="garden-hero__button m3-state-layer">{i18n(Key.gardenBrowse)}<Icon icon="material-symbols:arrow-forward-rounded" width="19" height="19" /></a>
	</div>
	<span class="garden-hero__caption">{i18n(Key.gardenHeroCaption)}</span>
	<span class="garden-hero__corner" aria-hidden="true"><Icon icon="material-symbols:filter-vintage-outline" width="40" height="40" /></span>
</section>

{featured && <article class="garden-featured">
	<div class="garden-featured__symbol" aria-hidden="true"><Icon icon="material-symbols:eco-outline-rounded" width="46" height="46" /></div>
	<div class="garden-featured__body">
		<p class="garden-featured__label"><Icon icon="material-symbols:keep-outline-rounded" width="13" height="13" />{i18n(Key.pinned)}<span> / </span>{i18n(Key.gardenFeatured)}</p>
		<h2><a href={getPostUrl(featured)}>{featured.data.title}</a></h2>
		<p class="garden-featured__description">{featured.data.description}</p>
	</div>
	<a class="garden-featured__arrow m3-state-layer" href={getPostUrl(featured)} aria-label={featured.data.title}><Icon icon="material-symbols:arrow-outward-rounded" width="23" height="23" /></a>
</article>}

<section id="garden-journal" class="garden-journal" aria-labelledby="garden-journal-title" data-garden-journal>
	<div class="garden-journal__heading">
		<div class="garden-journal__title"><span class="garden-journal__marker"></span><h2 id="garden-journal-title">{i18n(Key.gardenLatest)}</h2><span class="garden-journal__count">{String(displayPosts.length).padStart(2, "0")}</span></div>
		<div class="garden-view" role="group" aria-label={i18n(Key.layoutMode)}>
			<button type="button" class="garden-view__button m3-state-layer" data-garden-view="grid" aria-label={i18n(Key.layoutGrid)} aria-pressed="true"><Icon icon="material-symbols:grid-view-outline-rounded" width="18" height="18" /></button>
			<button type="button" class="garden-view__button m3-state-layer" data-garden-view="list" aria-label={i18n(Key.layoutList)} aria-pressed="false"><Icon icon="material-symbols:view-list-outline-rounded" width="18" height="18" /></button>
		</div>
	</div>
	<div class="garden-filter" role="group" aria-label={i18n(Key.gardenFilterLabel)}>
		<button type="button" class="garden-filter__item m3-state-layer" data-garden-filter="*" aria-pressed="true">{i18n(Key.gardenAll)}<span>{displayPosts.length}</span></button>
		{categories.map((category) => <button type="button" class="garden-filter__item m3-state-layer" data-garden-filter={category} aria-pressed="false">{category}<span>{displayPosts.filter((post) => post.data.category === category).length}</span></button>)}
	</div>
	<p class="sr-only" data-garden-result-status aria-live="polite" data-template={i18n(Key.gardenResults)}></p>
	<div class="garden-posts" data-garden-posts data-view="grid">
		{displayPosts.map((post, index) => <article class="garden-post" data-garden-category={post.data.category}>
			<a href={getPostUrl(post)} class="garden-post__image-link" tabindex="-1" aria-hidden="true">
				<img src={post.data.image || url("/images/garden/forest.webp")} width="900" height="600" alt="" loading="lazy" decoding="async" />
				<span class="garden-post__category">{post.data.category}</span>
				<span class="garden-post__number">{String(index + 1).padStart(2, "0")}</span>
			</a>
			<div class="garden-post__body">
				<div class="garden-post__meta"><time datetime={post.data.published.toISOString()}>{date(post.data.published)}</time><span>·</span><span>{minutes(post)}</span></div>
				<h3><a href={getPostUrl(post)}>{post.data.title}</a></h3>
				<p class="garden-post__excerpt">{post.data.description}</p>
				<div class="garden-post__bottom"><div class="garden-post__tags">{post.data.tags.slice(0, 2).map((tag) => <a href={url(`/archive/?tag=${encodeURIComponent(tag)}`)}># {tag}</a>)}</div><a href={getPostUrl(post)} class="garden-post__read m3-state-layer" aria-label={`${i18n(Key.gardenReadMore)} · ${post.data.title}`}><Icon icon="material-symbols:arrow-forward-rounded" width="19" height="19" /></a></div>
			</div>
		</article>)}
	</div>
	<p class="garden-journal__end"><span></span><Icon icon="material-symbols:eco-outline-rounded" width="17" height="17" />{i18n(Key.gardenGrowing)}<span></span></p>
	<a href={url("/archive/")} class="garden-archive-link m3-state-layer">{i18n(Key.gardenViewArchive)}<Icon icon="material-symbols:arrow-forward-rounded" width="17" height="17" /></a>
</section>

<script>
	// Delegation binds once to the persistent document and also serves Swup visits.
	document.addEventListener("click", (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;
		const filter = target.closest<HTMLButtonElement>("[data-garden-filter]");
		if (filter) {
			const journal = filter.closest<HTMLElement>("[data-garden-journal]");
			if (!journal) return;
			const category = filter.dataset.gardenFilter;
			journal.querySelectorAll<HTMLButtonElement>("[data-garden-filter]").forEach((button) => button.setAttribute("aria-pressed", String(button === filter)));
			let count = 0;
			journal.querySelectorAll<HTMLElement>("[data-garden-category]").forEach((article) => {
				article.hidden = category !== "*" && article.dataset.gardenCategory !== category;
				if (!article.hidden) count++;
			});
			const status = journal.querySelector<HTMLElement>("[data-garden-result-status]");
			if (status) status.textContent = (status.dataset.template ?? "{count}").replace("{count}", String(count));
		}
		const view = target.closest<HTMLButtonElement>("[data-garden-view]");
		if (view) {
			const journal = view.closest<HTMLElement>("[data-garden-journal]");
			const posts = journal?.querySelector<HTMLElement>("[data-garden-posts]");
			if (!posts) return;
			posts.dataset.view = view.dataset.gardenView;
			journal?.querySelectorAll<HTMLButtonElement>("[data-garden-view]").forEach((button) => button.setAttribute("aria-pressed", String(button === view)));
		}
	});
</script>

<style lang="stylus">
@import "../../styles/breakpoints.styl"
