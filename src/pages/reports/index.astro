---
/**
 * 前沿日报/周报聚合页：按发布日期倒序列出全部报告。
 * 数据来自 reports collection（scripts/sync-reports.mjs 从 frontier-report 同步）。
 */
import { getCollection } from "astro:content";
import Key from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { url } from "@utils/url-utils";

const reports = (await getCollection("reports"))
	.filter((r) => !r.data.draft)
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

type ReportEntry = (typeof reports)[number];

/** 类型徽标：category / tags 含 weekly/周报，或文件名含 weekly → Weekly，否则 Daily */
function reportKind(entry: ReportEntry): "Daily" | "Weekly" {
	if (/weekly|周报/i.test(entry.data.category)) return "Weekly";
	if (entry.data.tags.some((t) => /weekly|周报/i.test(t))) return "Weekly";
	if (entry.id.includes("weekly")) return "Weekly";
	return "Daily";
}

/** 分类筛选项：按 category 原始值去重，空值归入「未分类」。 */
const categoryOptions = Array.from(
	new Set(reports.map((r) => (r.data.category || "").trim())),
).filter(Boolean);
---

<MainGridLayout title={i18n(Key.blogReports)} description={i18n(Key.blogReportsIntro)} page="reports">
	<section class="reports-intro">
		<h1 class="reports-title">{i18n(Key.blogReports)}</h1>
		<p class="reports-lead">{i18n(Key.blogReportsIntro)}</p>
		<p class="reports-meta">{i18n(Key.blogEntryCount).replace("{count}", String(reports.length))}</p>
	</section>

	{
		categoryOptions.length > 0 && (
			<nav class="reports-filters" aria-label={i18n(Key.categories)}>
				<button type="button" class="reports-filter is-active" data-filter="all" aria-pressed="true">
					{i18n(Key.blogReportsAll)} <span class="reports-filter__count">{reports.length}</span>
				</button>
				{categoryOptions.map((category) => {
					const count = reports.filter(
						(r) => (r.data.category || "").trim() === category,
					).length;
					return (
						<button
							type="button"
							class="reports-filter"
							data-filter={category}
							aria-pressed="false"
						>
							{category} <span class="reports-filter__count">{count}</span>
						</button>
					);
				})}
			</nav>
		)
	}

	<section class="reports-list">
		{reports.length === 0 && <p class="reports-empty">No reports yet — waiting for the first sync.</p>}
		{
			reports.map((r) => {
				const kind = reportKind(r);
				const dateStr = formatDateToYYYYMMDD(r.data.published);
				return (
					<a class="reports-item" data-category={(r.data.category || "").trim()} href={url(`/reports/${encodeURIComponent(r.id)}/`)}>
						<span class={`reports-badge reports-badge--${kind === "Weekly" ? "weekly" : "daily"}`}>{kind}</span>
						<span class="reports-item__main">
							<span class="reports-item__title">{r.data.title}</span>
							{r.data.description && <span class="reports-item__desc">{r.data.description}</span>}
						</span>
						<time class="reports-item__date" datetime={dateStr}>{dateStr}</time>
					</a>
				);
			})
		}
	</section>
</MainGridLayout>

<style>
	.reports-intro { margin: 0 0 2.5rem; }
	.reports-title { font: var(--m3e-type-headline-large); margin: 0 0 0.75rem; }
	.reports-lead { font: var(--m3e-type-body-large); color: var(--on-surface-variant); margin: 0 0 0.5rem; }
	.reports-meta { font: var(--m3e-type-label-medium); color: var(--on-surface-variant); margin: 0; }
	.reports-list { display: flex; flex-direction: column; }
	.reports-empty { font: var(--m3e-type-body-medium); color: var(--on-surface-variant); }
	.reports-item { display: flex; align-items: baseline; gap: 0.75rem; padding: 0.75rem 0; border-bottom: 1px dashed color-mix(in oklab, var(--on-surface) 10%, transparent); text-decoration: none; color: inherit; }
	.reports-item:hover .reports-item__title { color: var(--primary); }
	.reports-badge { flex-shrink: 0; padding: 0.15rem 0.6rem; border-radius: var(--shape-corner-full); font: var(--m3e-type-label-medium); }
	.reports-badge--daily { background: var(--secondary-container); color: var(--on-secondary-container); }
	.reports-badge--weekly { background: var(--tertiary-container); color: var(--on-tertiary-container); }
	.reports-item__main { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
	.reports-item__title { font: var(--m3e-type-body-large); transition: color 0.15s; }
	.reports-item__desc { font: var(--m3e-type-body-small); color: var(--on-surface-variant); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.reports-item__date { margin-left: auto; flex-shrink: 0; font: var(--m3e-type-label-medium); color: var(--on-surface-variant); }
	.reports-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.5rem; }
	.reports-filter { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.9rem; border: 1px solid var(--outline-variant); border-radius: var(--shape-corner-full); background: var(--surface-container-low); color: var(--on-surface-variant); font: var(--m3e-type-label-large); cursor: pointer; transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard), color var(--m3e-duration-short) var(--m3e-easing-standard), border-color var(--m3e-duration-short) var(--m3e-easing-standard); }
	.reports-filter:hover { background: color-mix(in oklab, var(--on-surface) 8%, transparent); }
	.reports-filter.is-active { background: var(--primary); border-color: var(--primary); color: var(--on-primary); }
	.reports-filter__count { font-variant-numeric: tabular-nums; font-weight: 600; opacity: 0.75; }
	.reports-item[hidden] { display: none; }
</style>

<script>
	// 分类筛选：纯 DOM 过滤，无额外依赖。按 data-category 精确匹配。
	const filters = document.querySelectorAll<HTMLButtonElement>(".reports-filter");
	const items = document.querySelectorAll<HTMLAnchorElement>(".reports-item");
	filters.forEach((filter) => {
		filter.addEventListener("click", () => {
			const value = filter.dataset.filter || "all";
			filters.forEach((f) => {
				const active = f === filter;
				f.classList.toggle("is-active", active);
				f.setAttribute("aria-pressed", String(active));
			});
			items.forEach((item) => {
				const category = item.dataset.category || "";
				item.hidden = value !== "all" && category !== value;
			});
		});
	});
</script>
