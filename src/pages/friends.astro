---
import { getEntry, render } from "astro:content";
import Card from "@components/atoms/display/Card.svelte";
import Markdown from "@components/content/Markdown.astro";
import FriendSection from "@components/organisms/FriendSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nText } from "@utils/i18n-utils";
import { getMarkdownStylesheetAssets } from "@utils/markdown-assets";
import { friendsConfig } from "@/config/friendsConfig";
import { getFriendsList } from "../data/friends";
import { url } from "@utils/url-utils";

if (!friendsConfig.enable) {
	return Astro.redirect(url("/404.html"));
}

const pageTitle = resolveI18nText(friendsConfig.title, I18nKey.friends);
const pageDescription = resolveI18nText(
	friendsConfig.description,
	I18nKey.friendsBanner,
);

const friendsPost = await getEntry("spec", "friends");
const rendered = friendsPost ? await render(friendsPost) : null;
const markdownStylesheetAssets = rendered
	? await getMarkdownStylesheetAssets(
			rendered.remarkPluginFrontmatter.markdownSyntaxes,
		)
	: [];
---
<MainGridLayout title={pageTitle} description={pageDescription} page="friends">
    {markdownStylesheetAssets.map(({ pack, css }) => <style is:inline slot="head" data-swup-optional={pack} set:html={css}></style>)}
    {rendered && (
        <div class="flex w-full rounded-[var(--shape-corner-l)] overflow-hidden relative min-h-32">
            <Card color="var(--card-bg)" radius="l" class="z-10 p-6 lg:p-8 relative w-full">
                <Markdown class="mt-2">
                    <rendered.Content />
                </Markdown>
            </Card>
        </div>
    )}
    <FriendSection friends={getFriendsList().map(friend => ({ ...friend, imgurl: url(friend.imgurl), siteurl: url(friend.siteurl) }))} title={pageTitle} subtitle={pageDescription} client:visible></FriendSection>
</MainGridLayout>
